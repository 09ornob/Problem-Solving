Given:

[0, 1, 0, 3, 12]

Move all zeroes to the end without changing the relative order of non-zero elements.

Expected:

[1, 3, 12, 0, 0]


Solution:

const nums = [0, 1, 0, 3, 12];
let pos = 0;

for (let i = 0; i < nums.length; i++) {
  if (nums[i] !== 0) {
    nums[pos] = nums[i];
    pos += 1;
  }
}

while (pos < nums.length) {
  nums[pos] = 0;
  pos++;
}

console.log(nums);
