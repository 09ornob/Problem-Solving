Given:

[1, 1, 2]

Modify the array in-place so that each value appears only once.

Expected:

[1, 2, _]

Return:

2


Solution:

const nums = [1, 2, 1, 3];
let pos = 0;
const set = new Set();

for (let i = 0; i < nums.length; i++) {
  if (!set.has(nums[i])) {
    set.add(nums[i]);
    nums[pos] = nums[i];
    pos++;
  }
}

while (pos < nums.length) {
  nums[pos] = "_";
  pos++;
}

console.log(nums);
